# Bu dosya commit edilir; gerçek değerler .env içine yazılır (.env gitignore'da).
#   cp .env.example .env    ve aşağıdaki placeholder'ları doldur.

# --- Veritabanı ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gameteams
DB_USER=gameteams
DB_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Uygulama ---
SERVER_PORT=8080
# Doğrulama ve şifre sıfırlama maillerindeki linkler bu adrese işaret eder.
APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- JWT ---
# En az 32 byte rastgele değer üret:  openssl rand -base64 48
JWT_SECRET=change-me-with-a-long-random-secret
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# --- Çerez ---
# Prod'da mutlaka true (yalnızca HTTPS üzerinden gönderilir).
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- E-posta ---
# Kod sağlayıcıdan bağımsız: düz SMTP. Sağlayıcı değiştirmek yalnızca
# aşağıdaki dört değeri değiştirmek demektir, kod dokunulmaz.
#
#   Dev  : Mailpit -> localhost:1025, auth yok
#   Prod : Brevo   -> smtp-relay.brevo.com:587
#          (AWS SES sandbox'tan çıkışı reddettiği için bırakıldı)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
# Gönderen adres. Sağlayıcılar genelde yalnızca kimlik doğrulanan kutunun
# adresinden (veya onun bir takma adından) göndermeye izin verir.
MAIL_FROM=no-reply@gameteams.local
# 587 portunda ikisi de zorunlu. Prod'da true; dev'de Mailpit auth istemez.
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAILPIT_UI_PORT=8025

# --- Güvenlik ---
# Tanınmayan cihazdan girişte e-postaya 6 haneli kod gönderilir.
# E-posta teslimatı bozulursa (SMTP hatası, doğrulanmamış gönderen) kimse giriş yapamaz;
# kurtarmak için false yapıp backend'i yeniden başlat.
DEVICE_VERIFICATION=true

# --- Dosya yükleme ---
# Avatarlar diske yazılır. Prod'da compose bunu bir volume'a bağlar
# (docker-compose.prod.yml -> avatar-data), yerelde repo altında kalır.
AVATAR_DIR=./uploads/avatars
MAX_AVATAR_BYTES=2097152

# --- Dev admin kullanıcısı ---
# ADMIN_PASSWORD boş bırakılırsa seeder çalışmaz. PROD'DA BOŞ BIRAK.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@gameteams.local
ADMIN_PASSWORD=change-me

# ===========================================================================
# Aşağıdakiler yalnızca production için gerekli
# ===========================================================================

# Alan adı — nginx sertifikası ve sunucu adı bunu kullanır.
DOMAIN=

# --- WebRTC / TURN ---
# Symmetric NAT arkasındaki kullanıcılar TURN olmadan birbirini duyamaz.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
# openssl rand -hex 32
TURN_SECRET=
TURN_TTL=PT12H
# EC2'nin Elastic IP'si — coturn NAT arkasında bunu duyurur.
TURN_EXTERNAL_IP=

# --- Imajlar (CI/CD) ---
# GitHub Actions bu imajlari GHCR'a iter, deploy.sh --pull bunlari ceker.
# Elle deploy edeceksen bos birak; yerelde derlenir.
BACKEND_IMAGE=ghcr.io/teomangvn/gameteams-backend:latest
FRONTEND_IMAGE=ghcr.io/teomangvn/gameteams-frontend:latest

# --- Yedekleme (opsiyonel) ---
BACKUP_S3_BUCKET=
RETENTION_DAYS=14
