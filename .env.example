# Bu dosya commit edilir; gerçek değerler .env içine yazılır (.env gitignore'da).
#   cp .env.example .env    ve aşağıdaki placeholder'ları doldur.

# --- Veritabanı ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gameteams
DB_USER=gameteams
DB_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Uygulama ---
SERVER_PORT=8080
APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- JWT ---
# En az 32 byte rastgele değer üret:  openssl rand -base64 48
JWT_SECRET=change-me-with-a-long-random-secret
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# --- E-posta ---
# Dev: Mailpit (auth yok). Prod: AWS SES SMTP.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@gameteams.local
MAILPIT_UI_PORT=8025

# --- Dev admin kullanıcısı ---
# ADMIN_PASSWORD boş bırakılırsa seeder çalışmaz (prod'da boş bırak).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@gameteams.local
ADMIN_PASSWORD=change-me
